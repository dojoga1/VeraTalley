{
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "always",
  "overrides": [
    {
      "files": "*.sol",
      "options": {
        "semi": true,
        "singleQuote": false,
        "printWidth": 100,
        "tabWidth": 4
      }
    },
    {
      "files": ["*.yml", "*.yaml", "*.json"],
      "options": { "singleQuote": false }
    }
  ]
}
