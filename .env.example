# Copy this file to .env and fill in the values. Never commit .env.
#
#   cp .env.example .env
#
# The repository is public. Anything committed here is permanent and worldwide.
# If you ever paste a real value into this file by accident, tell Bhargav
# immediately rather than quietly deleting it: the value has to be rotated.

# ---------------------------------------------------------------------------
# Blockchain
# ---------------------------------------------------------------------------

# Polygon Amoy testnet, chain ID 80002.
# dRPC's free public endpoint below responds today and is fine for reads and
# light use, but it is RATE LIMITED. For real work (deploying, load) make your
# own free key at https://drpc.org and use that instead.
# The old endpoint rpc-amoy.polygon.technology was switched off in July 2026 —
# do not use it.
RPC_URL_AMOY=https://polygon-amoy.drpc.org
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com

# The election factory. Everything else in the system is discovered from it.
# Take the value from packages/contracts/deployments/amoy.json — that is the
# REAL factory, live on Amoy (isStub: false). (The retired stub in src/stub/ is
# for local testing only and is not deployed.)
NEXT_PUBLIC_FACTORY_ADDRESS=

# Deployment wallet. Bhargav only. This key owns every deployed contract.
# It lives in a password manager and in GitHub Actions secrets, nowhere else.
# You do not need it to work on any Week 1 issue.
DEPLOYER_PRIVATE_KEY=

# Block explorer API key, used to verify contract source after deployment.
POLYGONSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Database. Matches infra/docker-compose.yml. Local development only.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://veratalley:veratalley@localhost:5432/veratalley?schema=public

# ---------------------------------------------------------------------------
# Admin session, used by Sign In With Ethereum (VT-107)
# ---------------------------------------------------------------------------

# Any random string of at least 32 characters. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
