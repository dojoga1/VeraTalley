# Dependencies
node_modules/
.pnpm-store/

# Secrets. Never commit any of these. See .env.example for the shape.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
**/deployments/*.private.json

# Build output
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Regenerated by Next.js on every `next dev` and `next build`. Committing it
# just produces a conflict every time two people run the dev server.
next-env.d.ts

# Hardhat
artifacts/
cache/
types/generated/
ignition/deployments/chain-31337/

# Prisma
packages/db/prisma/*.db
packages/db/prisma/*.db-journal

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
